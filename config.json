{
  # Path to the highscore file (relative to the game directory)
  "highscore_filename": "highscores.json",

  # Number of lives the player starts with
  "lives": 3,

  # Number of regular pacgums per level (used if maze generator needs a count)
  "pacgum": 42,

  # Points awarded per regular pacgum eaten
  "points_per_pacgum": 10,

  # Points awarded per super-pacgum (power pellet) eaten
  "points_per_super_pacgum": 50,

  # Base points for eating the 1st ghost during one power-up window.
  # Subsequent ghosts award 2x, 4x, 8x this value (200 -> 400 -> 800 -> 1600).
  "points_per_ghost": 200,

  # How long (seconds) ghosts stay frightened after a super-pacgum
  "frightened_duration": 7.0,

  # How long (seconds) before an eaten ghost respawns at its corner
  "ghost_respawn_delay": 5.0,

  # Player speed in tiles per second
  "player_speed": 5.0,
  # Ghost base speed in tiles per second
  "ghost_base_speed": 4.0,

  # Ghost speed multiplier while frightened (0.5 = half speed)
  "frightened_speed_factor": 0.5,

  # Level definitions — at least 10 required.
  # Missing levels are auto-generated by speeding up ghosts slightly.
  "levels": [
    { "width": 21, "height": 21, "time_limit": 90, "ghost_speed_factor": 1.0 },
    { "width": 21, "height": 21, "time_limit": 85, "ghost_speed_factor": 1.1 },
    { "width": 23, "height": 23, "time_limit": 80, "ghost_speed_factor": 1.2 },
    { "width": 23, "height": 23, "time_limit": 75, "ghost_speed_factor": 1.3 },
    { "width": 25, "height": 25, "time_limit": 70, "ghost_speed_factor": 1.4 },
    { "width": 25, "height": 25, "time_limit": 65, "ghost_speed_factor": 1.5 },
    { "width": 27, "height": 27, "time_limit": 60, "ghost_speed_factor": 1.6 },
    { "width": 27, "height": 27, "time_limit": 55, "ghost_speed_factor": 1.7 },
    { "width": 29, "height": 29, "time_limit": 50, "ghost_speed_factor": 1.8 },
    { "width": 29, "height": 29, "time_limit": 45, "ghost_speed_factor": 1.9 }
  ]
}
